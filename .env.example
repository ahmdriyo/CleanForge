# CleanForge ENV Example — fill manually, do not commit real values
# See docs/prd-backend.md for details

# Firebase (public, from Firebase console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (private, service account JSON string)
# Either set GOOGLE_APPLICATION_CREDENTIALS=file path or JSON string
GOOGLE_APPLICATION_CREDENTIALS=

# GCP & Secret Manager
GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=

# Gemini API (Flash only) — via Secret Manager or env fallback
GEMINI_API_KEY=
GOOGLE_API_KEY=

# MCP JWT Secret (HS256, 32+ chars)
MCP_JWT_SECRET=

# API Base (optional, for axios base-api.ts)
NEXT_PUBLIC_API_BASE_URL=

# Node
NODE_ENV=
