# CleanForge ENV Example — fill manually, do not commit real values
# See docs/prd-backend.md for details

# Firebase (public, from Firebase console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (private) — PICK ONE:
# Option A: Separate vars (recommended for Secret Manager / Vercel, no JSON escaping)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Option B: JSON string (single secret)
# GO TO Firebase Console > Project Settings > Service Accounts > Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=

# GCP & Secret Manager (needed only if fetching secrets from Secret Manager)
GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=

# Gemini API (Flash only) — via Secret Manager or env fallback
GEMINI_API_KEY=

# MCP JWT Secret (HS256, 32+ chars)
MCP_JWT_SECRET=

# API Base (optional, for axios base-api.ts)
NEXT_PUBLIC_API_BASE_URL=

# Node
NODE_ENV=
