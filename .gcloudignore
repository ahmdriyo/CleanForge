# gcloudignore — allow .env for NEXT_PUBLIC inlining at build time
# (overrides .gitignore which ignores .env*). We still ignore secrets that shouldn't be in image.

.git
.gitignore
node_modules
.next
out
build
coverage
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
*.tsbuildinfo
next-env.d.ts
# Keep .env.example but allow .env (contains NEXT_PUBLIC Firebase vars needed for build)
!.env
.env.local
.env.development.local
.env.test.local
.env.production.local
